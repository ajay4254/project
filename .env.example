# CogniMind Environment Variables
# Copy this file to .env and update values

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./cognimind.db
# DATABASE_URL=postgresql://user:password@localhost:5432/cognimind

# JWT Secret Key - CHANGE THIS IN PRODUCTION
SECRET_KEY=cognimind-dev-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
FRONTEND_URL=http://localhost:5173

# App
APP_NAME=CogniMind
APP_VERSION=1.0.0
DEBUG=true
